# Text: normalised to LF in the repository, native line endings on checkout.
* text=auto

# Windows-only formats keep CRLF in the working tree.
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Diff C# and Python as code.
*.cs      text diff=csharp
*.py      text diff=python

# Binary files go through Git LFS, never into plain history.
# (HTC/Tobii binaries and models are ignored entirely; see .gitignore.)
*.dll     filter=lfs diff=lfs merge=lfs -text
*.exe     filter=lfs diff=lfs merge=lfs -text
*.pdb     filter=lfs diff=lfs merge=lfs -text
*.so      filter=lfs diff=lfs merge=lfs -text
*.lib     filter=lfs diff=lfs merge=lfs -text
